# Normalize line endings. Source and scripts stay LF so they run correctly inside
# the Linux Docker containers regardless of the host OS.
* text=auto eol=lf

*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.sql   text eol=lf
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.md    text eol=lf

# Windows-only scripts, if any, keep CRLF
*.ps1   text eol=crlf

# Binaries
*.pdf   binary
*.png   binary
*.jpg   binary

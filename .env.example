# ============================================================================
# Compliance Advisory Copilot — environment configuration
# Copy this file to `.env` and fill in the blanks. NEVER commit `.env`.
# ============================================================================

# ---- App ----
APP_ENV=development
APP_NAME=compliance-advisory-copilot
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed browser origins for CORS
CORS_ORIGINS=http://localhost:3000

# ---- Security / Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- PostgreSQL (with pgvector) ----
POSTGRES_USER=cac
POSTGRES_PASSWORD=cac_password
POSTGRES_DB=cac
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# The app builds the async DSN from the parts above; override if needed.
# DATABASE_URL=postgresql+asyncpg://cac:cac_password@localhost:5432/cac

# ---- Redis (job queue + cache) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---- Object storage (MinIO / S3-compatible) ----
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=circulars
S3_REGION=us-east-1

# ============================================================================
# LLM — PROVIDER AGNOSTIC (powered by LiteLLM)
# ----------------------------------------------------------------------------
# You can point this at ANY provider by changing LLM_MODEL + the matching key.
# The model string uses LiteLLM's "<provider>/<model>" convention.
#
# Gemini:      LLM_MODEL=gemini/gemini-3.7-flash       + GEMINI_API_KEY   <-- in use
# OpenAI:      LLM_MODEL=openai/gpt-4o-mini            + OPENAI_API_KEY
# Anthropic:   LLM_MODEL=anthropic/claude-sonnet-5     + ANTHROPIC_API_KEY
# Azure:       LLM_MODEL=azure/<deployment>            + AZURE_API_KEY/BASE/VERSION
# Local (Ollama): LLM_MODEL=ollama/llama3.1            + OLLAMA_API_BASE
# ============================================================================
LLM_PROVIDER=gemini
LLM_MODEL=gemini/gemini-3.7-flash
# Keep at 1.0 for Gemini 3: Google warns that lower values degrade reasoning and can
# cause infinite loops on complex tasks.
LLM_TEMPERATURE=1.0
LLM_MAX_TOKENS=8192

# Get a key at aistudio.google.com/apikey and put it in `.env` — NEVER in this
# file. This one is committed to git; `.env` is gitignored.
GEMINI_API_KEY=

# Drop in whichever key matches LLM_MODEL above. Unused ones can stay blank.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=

# ---- Embeddings (also provider-agnostic via LiteLLM) ----
# Set EMBEDDING_MODEL to a LiteLLM model id. If no key is available the app
# falls back to a local sentence-transformers model (see settings).
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536
# Local fallback (used only when USE_LOCAL_EMBEDDINGS=true)
USE_LOCAL_EMBEDDINGS=false
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOCAL_EMBEDDING_DIM=384

# ---- PDF ingestion ----
MAX_UPLOAD_MB=25
MIN_EXTRACTED_CHARS=200

# ---- OCR (scanned PDFs) ----
# Runs locally — a regulatory document is never sent to a third-party OCR service.
# Decided per page, so a hybrid PDF (typed body + scanned annexure) works correctly.
OCR_ENABLED=true
# auto = prefer tesseract (better on italic serif), fall back to rapidocr (pip-only).
# Force one with: tesseract | rapidocr
OCR_ENGINE=auto
OCR_DPI=200
# A page whose text layer is shorter than this is treated as a scan and sent to OCR.
OCR_MIN_PAGE_CHARS=80
# Hard cap so one huge scan cannot occupy the worker indefinitely.
OCR_MAX_PAGES=60
# Tesseract only. Add Hindi with "eng+hin" once hin.traineddata is installed.
OCR_LANGUAGES=eng
# Only needed if the tesseract binary is not on PATH, e.g.
# Windows: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# macOS (Homebrew installs it on PATH, so this is normally unnecessary):
#   Apple silicon: TESSERACT_CMD=/opt/homebrew/bin/tesseract
#   Intel:         TESSERACT_CMD=/usr/local/bin/tesseract
TESSERACT_CMD=

# ---- Notifications (Phase 1; safe to leave blank for MVP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_FROM=compliance-copilot@example.com

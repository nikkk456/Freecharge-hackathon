{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // No `baseUrl`: it is deprecated in TS 5.9 and removed in TS 7. With
    // moduleResolution "bundler", `paths` resolves relative to this file, so the
    // alias works without it. Vite has the matching alias in vite.config.ts.
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"]
}
